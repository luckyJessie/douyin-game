/* 豆芽五子棋微信小程序样式示例 */
/* gomoku.wxss */

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  width: 100%;
  text-align: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.status {
  font-size: 28rpx;
  color: #666;
}

.board {
  background-color: #d4a574;
  padding: 20rpx;
  border-radius: 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.row {
  display: flex;
  flex-direction: row;
}

.cell {
  width: 40rpx;
  height: 40rpx;
  border: 1rpx solid #8b6914;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #d4a574;
}

.cell:active {
  background-color: #c49a64;
}

.piece {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
}

.cell.black .piece {
  background-color: #000;
  box-shadow: inset 2rpx 2rpx 4rpx rgba(255, 255, 255, 0.2);
}

.cell.white .piece {
  background-color: #fff;
  box-shadow: inset 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.footer {
  margin-top: 40rpx;
}

.restart-btn {
  background-color: #4CAF50;
  color: white;
  padding: 20rpx 40rpx;
  border-radius: 8rpx;
  font-size: 32rpx;
}

.restart-btn:active {
  background-color: #45a049;
}
