.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
  box-sizing: border-box;
  color: #f0f0f0;
}

.header {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.players {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 16rpx;
}

.player-card {
  min-width: 220rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.2s ease, background 0.2s ease;
  border: 2rpx solid transparent;
}

.player-card.active {
  background: rgba(255, 226, 109, 0.18);
  transform: translateY(-6rpx);
  box-shadow: 0 12rpx 36rpx rgba(255, 226, 109, 0.35);
  border: 2rpx solid rgba(255, 226, 109, 0.6);
}

.player-name {
  font-size: 34rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.player-role {
  font-size: 26rpx;
  color: #ffcc70;
}

.player-role.black {
  color: #f5f5f5;
}

.player-role.white {
  color: #e0f2ff;
}

.player-token {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.25);
}

.player-token.black {
  background: #1f1f1f;
}

.player-token.white {
  background: #f7f7f7;
  border-color: rgba(0, 0, 0, 0.2);
}

.vs-tag {
  margin: 0 24rpx;
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.6);
}

.status {
  font-size: 28rpx;
  color: #cfd9df;
  margin-top: 4rpx;
}

.board-wrapper {
  position: relative;
  margin-bottom: 32rpx;
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.25);
}

.board {
  width: 100%;
  height: 100%;
}

.result-banner {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  z-index: 2;
  row-gap: 24rpx;
}

.result-icon {
  width: 120rpx;
  height: 120rpx;
}

.result-text {
  font-size: 44rpx;
  font-weight: 600;
}

.result-button {
  padding: 0 36rpx;
  border-radius: 32rpx;
  border: none;
  background: linear-gradient(135deg, #7f7fd5, #86a8e7);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(134, 168, 231, 0.35);
  line-height: 68rpx;
  height: 68rpx;
}

.result-button::after {
  border: none;
}

.controls {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 24rpx;
  column-gap: 24rpx;
}

.control-btn {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  column-gap: 12rpx;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
  font-size: 28rpx;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.25);
}

.control-btn.primary {
  background: linear-gradient(135deg, #ffb347, #ffcc33);
  color: #222;
  box-shadow: 0 8rpx 24rpx rgba(255, 204, 51, 0.35);
}

.control-btn:disabled {
  opacity: 0.5;
}

.control-btn::after {
  border: none;
}

.btn-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.btn-label {
  font-size: 28rpx;
}

.difficulty {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.18);
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.difficulty text {
  font-size: 28rpx;
}

.picker {
  font-size: 28rpx;
  color: #ffe26d;
}

.footer {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}
