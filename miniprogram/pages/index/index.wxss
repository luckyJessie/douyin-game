.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
  box-sizing: border-box;
  color: #f0f0f0;
}

.header {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.players {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 16rpx;
}

.player-card {
  min-width: 200rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.2s ease, background 0.2s ease;
}

.player-card.active {
  background: rgba(255, 226, 109, 0.2);
  transform: translateY(-6rpx);
  box-shadow: 0 12rpx 36rpx rgba(255, 226, 109, 0.25);
}

.player-name {
  font-size: 34rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.player-role {
  font-size: 26rpx;
  color: #ffcc70;
}

.vs-tag {
  margin: 0 24rpx;
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.6);
}

.status {
  font-size: 28rpx;
  color: #cfd9df;
  margin-top: 4rpx;
}

.board-wrapper {
  position: relative;
  margin-bottom: 32rpx;
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.25);
}

.board {
  width: 100%;
  height: 100%;
}

.result-banner {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  z-index: 2;
  row-gap: 24rpx;
}

.result-text {
  font-size: 44rpx;
  font-weight: 600;
}

.result-button {
  padding: 0 36rpx;
}

.controls {
  width: 100%;
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.controls button {
  flex: 1;
  margin: 0 8rpx;
}

.difficulty {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.18);
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.difficulty text {
  font-size: 28rpx;
}

.picker {
  font-size: 28rpx;
  color: #ffe26d;
}

.footer {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}
