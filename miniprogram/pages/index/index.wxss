.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
  box-sizing: border-box;
  color: #f0f0f0;
}

.header {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.players {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 16rpx;
}

.player-card {
  min-width: 240rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.2s ease, background 0.2s ease;
  border: 2rpx solid transparent;
}

.player-card.active {
  background: rgba(255, 226, 109, 0.18);
  transform: translateY(-6rpx);
  box-shadow: 0 12rpx 36rpx rgba(255, 226, 109, 0.35);
  border: 2rpx solid rgba(255, 226, 109, 0.6);
}

.player-row {
  width: 100%;
  display: flex;
  align-items: center;
  column-gap: 18rpx;
}

.player-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.player-name {
  font-size: 34rpx;
  font-weight: 500;
}

.player-role {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.stone-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.35);
}

.stone-icon.black {
  background: #1f1f1f;
}

.stone-icon.white {
  background: #f7f7f7;
  border-color: rgba(0, 0, 0, 0.2);
}

.player-turn {
  margin-top: 12rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  background: rgba(255, 226, 109, 0.2);
  color: #ffe26d;
}

.vs-tag {
  margin: 0 24rpx;
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.6);
}

.status {
  font-size: 28rpx;
  color: #cfd9df;
  margin-top: 4rpx;
}

.board-wrapper {
  position: relative;
  margin-bottom: 32rpx;
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.25);
}

.board {
  width: 100%;
  height: 100%;
}

.result-banner {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  z-index: 2;
  row-gap: 24rpx;
}

.result-banner.win {
  background: rgba(68, 214, 164, 0.15);
  backdrop-filter: blur(6rpx);
}

.result-banner.lose {
  background: rgba(238, 92, 92, 0.18);
  backdrop-filter: blur(6rpx);
}

.result-banner.draw {
  background: rgba(164, 185, 207, 0.18);
  backdrop-filter: blur(6rpx);
}

.result-animate-pop {
  animation: result-pop 0.6s ease-out forwards;
}

.result-animate-shake {
  animation: result-shake 0.6s ease both;
}

.result-animate-pulse {
  animation: result-pulse 1s ease-in-out both;
}

.result-icon {
  width: 120rpx;
  height: 120rpx;
}

.result-text {
  font-size: 44rpx;
  font-weight: 600;
}

.result-button {
  padding: 0 36rpx;
  border-radius: 32rpx;
  border: none;
  background: linear-gradient(135deg, #7f7fd5, #86a8e7);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(134, 168, 231, 0.35);
  line-height: 68rpx;
  height: 68rpx;
}

.result-button::after {
  border: none;
}

.result-banner.win .result-text {
  color: #3ce1a0;
}

.result-banner.lose .result-text {
  color: #ff7676;
}

.result-banner.draw .result-text {
  color: #d1e4ff;
}

.result-banner.win .result-button {
  background: linear-gradient(135deg, #3be1a4, #7fffd4);
  box-shadow: 0 8rpx 24rpx rgba(59, 225, 164, 0.35);
}

.result-banner.lose .result-button {
  background: linear-gradient(135deg, #f5576c, #f093fb);
  box-shadow: 0 8rpx 24rpx rgba(245, 87, 108, 0.35);
}

.result-banner.draw .result-button {
  background: linear-gradient(135deg, #87a0c4, #b7c9f2);
  box-shadow: 0 8rpx 24rpx rgba(135, 160, 196, 0.35);
}

.result-banner.win .result-button::after,
.result-banner.lose .result-button::after,
.result-banner.draw .result-button::after {
  border: none;
}

.result-banner.win .result-button,
.result-banner.lose .result-button,
.result-banner.draw .result-button {
  color: #1e1e2f;
}

@keyframes result-pop {
  0% {
    transform: scale(0.7);
    opacity: 0;
  }
  60% {
    transform: scale(1.05);
    opacity: 1;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

@keyframes result-shake {
  0%,
  100% {
    transform: translateX(0);
  }
  20%,
  60% {
    transform: translateX(-18rpx);
  }
  40%,
  80% {
    transform: translateX(18rpx);
  }
}

@keyframes result-pulse {
  0% {
    transform: scale(0.9);
    opacity: 0;
  }
  50% {
    transform: scale(1);
    opacity: 1;
  }
  100% {
    transform: scale(0.95);
    opacity: 1;
  }
}

.controls {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 24rpx;
  column-gap: 24rpx;
}

.control-btn {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  column-gap: 12rpx;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
  font-size: 28rpx;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.25);
}

.control-btn.primary {
  background: linear-gradient(135deg, #ffb347, #ffcc33);
  color: #222;
  box-shadow: 0 8rpx 24rpx rgba(255, 204, 51, 0.35);
}

.control-btn:disabled {
  opacity: 0.5;
}

.control-btn::after {
  border: none;
}

.btn-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.btn-label {
  font-size: 28rpx;
}

.difficulty {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.18);
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.difficulty text {
  font-size: 28rpx;
}

.picker {
  font-size: 28rpx;
  color: #ffe26d;
}

.footer {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}
