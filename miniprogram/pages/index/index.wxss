.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #666;
}

.board-canvas {
  width: 640rpx;
  height: 640rpx;
  background: #dcb35c;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.12);
  border-radius: 12rpx;
}

.panel {
  width: 640rpx;
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.08);
}

.info-row {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.button-row {
  display: flex;
  justify-content: space-between;
}
