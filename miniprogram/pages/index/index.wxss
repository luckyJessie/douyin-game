.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
  box-sizing: border-box;
  color: #f0f0f0;
}

.header {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.players {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 16rpx;
}

.player-card {
  min-width: 240rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.2s ease, background 0.2s ease;
  border: 2rpx solid transparent;
}

.player-card.active {
  background: rgba(255, 226, 109, 0.18);
  transform: translateY(-6rpx);
  box-shadow: 0 12rpx 36rpx rgba(255, 226, 109, 0.35);
  border: 2rpx solid rgba(255, 226, 109, 0.6);
}

.player-row {
  width: 100%;
  display: flex;
  align-items: center;
  column-gap: 18rpx;
}

.player-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.player-name {
  font-size: 34rpx;
  font-weight: 500;
}

.player-role {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.stone-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.35);
}

.stone-icon.black {
  background: #1f1f1f;
}

.stone-icon.white {
  background: #f7f7f7;
  border-color: rgba(0, 0, 0, 0.2);
}

.vs-tag {
  margin: 0 24rpx;
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.6);
}

.status {
  font-size: 28rpx;
  color: #cfd9df;
  margin-top: 4rpx;
}

.board-wrapper {
  position: relative;
  margin-bottom: 32rpx;
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.25);
}

.board {
  width: 100%;
  height: 100%;
}

.result-banner {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  z-index: 2;
  row-gap: 28rpx;
  backdrop-filter: blur(10rpx);
  border-radius: 28rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.08);
}

.result-banner::before {
  content: '';
  position: absolute;
  inset: 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  pointer-events: none;
}

.result-banner.win {
  background: linear-gradient(160deg, rgba(53, 203, 162, 0.2), rgba(25, 135, 84, 0.55));
  box-shadow: 0 18rpx 68rpx rgba(48, 186, 146, 0.35);
}

.result-banner.lose {
  background: linear-gradient(160deg, rgba(255, 91, 91, 0.2), rgba(194, 57, 86, 0.55));
  box-shadow: 0 18rpx 68rpx rgba(206, 75, 93, 0.35);
}

.result-banner.draw {
  background: linear-gradient(160deg, rgba(142, 159, 189, 0.2), rgba(86, 101, 128, 0.55));
  box-shadow: 0 18rpx 68rpx rgba(120, 139, 174, 0.35);
}

.result-animate-pop {
  animation: result-pop 0.7s ease-out forwards;
}

.result-animate-shake {
  animation: result-shake 0.7s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
}

.result-animate-pulse {
  animation: result-pulse 1.2s ease-in-out both;
}

.result-text {
  font-size: 50rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.result-button {
  padding: 0 48rpx;
  border-radius: 40rpx;
  border: none;
  background: linear-gradient(140deg, #90a4ff, #b798ff);
  color: #fff;
  box-shadow: 0 14rpx 38rpx rgba(169, 179, 255, 0.35);
  line-height: 78rpx;
  height: 78rpx;
  font-size: 30rpx;
  letter-spacing: 3rpx;
}

.result-button::after {
  border: none;
}

.result-banner.win .result-text {
  color: #d7fff0;
  text-shadow: 0 6rpx 12rpx rgba(23, 86, 63, 0.35);
}

.result-banner.lose .result-text {
  color: #ffe3ec;
  text-shadow: 0 6rpx 12rpx rgba(92, 24, 38, 0.45);
}

.result-banner.draw .result-text {
  color: #dee7ff;
  text-shadow: 0 6rpx 12rpx rgba(32, 42, 64, 0.4);
}

.result-banner.win .result-button {
  background: linear-gradient(140deg, #63f5c1, #32c88d);
  color: #083f2e;
  box-shadow: 0 18rpx 48rpx rgba(50, 200, 141, 0.4);
}

.result-banner.lose .result-button {
  background: linear-gradient(140deg, #ff728a, #ff4b5c);
  color: #320612;
  box-shadow: 0 18rpx 48rpx rgba(255, 91, 112, 0.4);
}

.result-banner.draw .result-button {
  background: linear-gradient(140deg, #a1b2d6, #7f95c4);
  color: #162441;
  box-shadow: 0 18rpx 48rpx rgba(129, 149, 190, 0.4);
}

.result-banner.win .result-button::after,
.result-banner.lose .result-button::after,
.result-banner.draw .result-button::after {
  border: none;
}

@keyframes result-pop {
  0% {
    transform: translateY(80rpx) scale(0.88);
    opacity: 0;
  }
  55% {
    transform: translateY(-14rpx) scale(1.05);
    opacity: 1;
  }
  100% {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
}

@keyframes result-shake {
  0%,
  100% {
    transform: translateX(0) rotate(0);
  }
  15%,
  45%,
  75% {
    transform: rotate(-3deg) translateX(-28rpx);
  }
  30%,
  60%,
  90% {
    transform: rotate(3deg) translateX(28rpx);
  }
}

@keyframes result-pulse {
  0% {
    transform: scale(0.92);
    opacity: 0;
  }
  40% {
    transform: scale(1.05);
    opacity: 1;
  }
  70% {
    transform: scale(0.96);
    opacity: 1;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

.controls {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 24rpx;
  column-gap: 24rpx;
}

.control-btn {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  column-gap: 16rpx;
  padding: 0 32rpx;
  height: 72rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #4c5df3, #556bff);
  color: #ffffff;
  font-size: 28rpx;
  border: 1rpx solid rgba(76, 87, 255, 0.35);
  box-shadow: 0 10rpx 26rpx rgba(48, 66, 160, 0.25);
}

.control-btn text {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  line-height: 72rpx;
}

.control-btn.primary {
  background: linear-gradient(140deg, #ff7a7a, #ff4bb2);
  color: #ffffff;
  border-color: rgba(255, 99, 146, 0.45);
  box-shadow: 0 12rpx 30rpx rgba(255, 105, 155, 0.28);
}

.control-btn:disabled {
  opacity: 0.5;
}

.control-btn::after {
  border: none;
}

.btn-label {
  font-size: 28rpx;
  color: #ffffff;
}

.difficulty {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.18);
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.difficulty text {
  font-size: 28rpx;
}

.picker {
  font-size: 28rpx;
  color: #ffe26d;
}

.footer {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}
