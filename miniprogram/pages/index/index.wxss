.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
  box-sizing: border-box;
  color: #f0f0f0;
}

.header {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.status {
  font-size: 28rpx;
  color: #cfd9df;
}

.board {
  width: 650rpx;
  height: 650rpx;
  border-radius: 16rpx;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.25);
  margin-bottom: 32rpx;
}

.controls {
  width: 100%;
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.controls button {
  flex: 1;
  margin: 0 8rpx;
}

.difficulty {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.18);
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.difficulty text {
  font-size: 28rpx;
}

.picker {
  font-size: 28rpx;
  color: #ffe26d;
}

.footer {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}
