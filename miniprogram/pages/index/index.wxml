<view class="container">
  <view class="header">
    <text class="title">豆芽五子棋</text>
    <view class="players">
      <view class="player-card {{currentTurn === humanRoleConstant ? 'active' : ''}}">
        <view class="player-row">
          <view class="stone-icon black"></view>
          <view class="player-meta">
            <text class="player-name">玩家</text>
            <text class="player-role">黑棋</text>
          </view>
        </view>
        <text wx:if="{{currentTurn === humanRoleConstant}}" class="player-turn">落子中</text>
      </view>
      <view class="vs-tag">VS</view>
      <view class="player-card {{currentTurn === aiRoleConstant ? 'active' : ''}}">
        <view class="player-row">
          <view class="stone-icon white"></view>
          <view class="player-meta">
            <text class="player-name">电脑</text>
            <text class="player-role">白棋</text>
          </view>
        </view>
        <text wx:if="{{currentTurn === aiRoleConstant}}" class="player-turn">思考中</text>
      </view>
    </view>
    <text class="status">{{statusText}}</text>
  </view>

  <view class="board-wrapper" style="width: {{canvasDisplaySize}}px; height: {{canvasDisplaySize}}px;">
    <canvas
      class="board"
      canvas-id="board"
      bindtouchstart="handleTap"
      disable-scroll="true"
      style="width: {{canvasDisplaySize}}px; height: {{canvasDisplaySize}}px;"
      width="{{canvasPixelSize}}"
      height="{{canvasPixelSize}}"
    ></canvas>
      <view wx:if="{{gameOver}}" class="result-banner {{resultType}} {{resultAnimation}}">
      <text class="result-text">{{resultMessage}}</text>
      <button class="result-button" size="mini" type="primary" bindtap="handleRestart">再来一局</button>
    </view>
  </view>

    <view class="controls">
      <button class="control-btn primary" size="mini" bindtap="handleRestart" disabled="{{aiThinking}}">
        <text class="btn-label">重新开始</text>
      </button>
      <button class="control-btn" size="mini" bindtap="handleUndo" disabled="{{!canUndo || aiThinking}}">
        <text class="btn-label">悔棋</text>
      </button>
  </view>

  <view class="difficulty">
    <text>难度：{{difficulties[difficultyIndex].label}}</text>
    <picker mode="selector" range="{{difficultyLabels}}" value="{{difficultyIndex}}" bindchange="handleDifficultyChange">
      <view class="picker">{{difficultyLabels[difficultyIndex]}}</view>
    </picker>
  </view>

  <view class="footer">
    <text>提示：点击棋盘落子。电脑自动应对。</text>
  </view>
</view>
