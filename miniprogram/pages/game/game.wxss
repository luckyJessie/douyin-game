.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.status-panel {
  width: 100%;
  margin-bottom: 24rpx;
  text-align: center;
}

.message {
  font-size: 32rpx;
  color: #333333;
  font-weight: 600;
}

.controls {
  width: 100%;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
  margin-bottom: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.control-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  flex-wrap: wrap;
}

.control-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  align-items: center;
}

.tag {
  background: rgba(112, 75, 28, 0.08);
  color: #704b1c;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 1;
}

.tag.mode {
  background: rgba(255, 179, 71, 0.18);
  color: #b46c13;
}

.btn-link {
  border: none;
  background: none;
  color: #3a7afe;
  font-size: 26rpx;
  padding: 0;
  line-height: 1.4;
}

.btn-link::after {
  content: '';
}

.control-actions {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.online-panel {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  align-items: center;
}

.room-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 26rpx;
  color: #444444;
  text-align: center;
}

.room-actions {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.room-input {
  width: 220rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid #d0d0d0;
  border-radius: 20rpx;
  font-size: 24rpx;
  background: #ffffff;
}

.online-status {
  font-size: 24rpx;
  color: #666666;
  text-align: center;
}

.turn-indicator {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666666;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 0;
}

.first-player {
  color: #9c6b30;
}


.board {
  width: 720rpx;
  height: 720rpx;
  background: linear-gradient(135deg, #f9ddb0, #e9b668);
  padding: 40rpx;
  border-radius: 24rpx;
  box-shadow: 0 22rpx 36rpx rgba(0, 0, 0, 0.18);
  box-sizing: border-box;
  border: 2rpx solid rgba(80, 50, 20, 0.38);
  display: flex;
  flex-direction: column;
  position: relative;
  gap: 0;
}

.board::before {
  content: '';
  position: absolute;
  inset: 40rpx;
  border-radius: 12rpx;
  background-color: rgba(255, 255, 255, 0.05);
  background-image:
    linear-gradient(to right, rgba(53, 33, 14, 0.28) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(53, 33, 14, 0.28) 1px, transparent 1px);
  background-size: calc(100% / 14) calc(100% / 14);
  pointer-events: none;
  z-index: 0;
}

.board::after {
  content: '';
  position: absolute;
  inset: 36rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  pointer-events: none;
  z-index: 3;
}

.stone-layer,
.star-layer,
.touch-layer {
  position: absolute;
  top: 40rpx;
  bottom: 40rpx;
  left: 40rpx;
  right: 40rpx;
  display: grid;
  grid-template-columns: repeat(15, minmax(0, 1fr));
  grid-template-rows: repeat(15, minmax(0, 1fr));
  pointer-events: none;
  z-index: 1;
}

.stone-layer {
  z-index: 2;
  pointer-events: none;
}

.star-layer {
  z-index: 2;
  pointer-events: none;
}

.touch-layer {
  pointer-events: auto;
  z-index: 4;
}

.stone-cell,
.star-cell,
.touch-cell {
  display: flex;
  align-items: center;
  justify-content: center;
}

.stone-cell {
  pointer-events: none;
  position: relative;
}

.stone-cell.last-cell::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 50%;
  box-shadow: 0 0 0 6rpx rgba(255, 205, 96, 0.55);
  pointer-events: none;
  transform: scale(1.25);
}

.star-dot {
  width: 14rpx;
  height: 14rpx;
  background: rgba(53, 33, 14, 0.9);
  border-radius: 50%;
  box-shadow: 0 0 0 3rpx rgba(255, 255, 255, 0.2);
}

.touch-cell {
  border-radius: 50%;
  background: transparent;
  width: 100%;
  height: 100%;
  position: relative;
}

.touch-cell:not(.disabled):active {
  background: rgba(255, 205, 96, 0.25);
}

.touch-cell.disabled {
  pointer-events: none;
}

.touch-cell.hint::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  border: 2rpx dashed rgba(96, 152, 255, 0.85);
  box-shadow: 0 0 12rpx rgba(96, 152, 255, 0.65);
  animation: hintPulse 1.2s ease-in-out infinite;
}

@keyframes hintPulse {
  0% {
    opacity: 0.8;
    transform: translate(-50%, -50%) scale(0.9);
  }
  50% {
    opacity: 0.2;
    transform: translate(-50%, -50%) scale(1.2);
  }
  100% {
    opacity: 0.8;
    transform: translate(-50%, -50%) scale(0.9);
  }
}

.piece {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  box-shadow: inset 0 4rpx 10rpx rgba(0, 0, 0, 0.35);
}

.piece.player {
  background: radial-gradient(circle at 30% 30%, #4f4f4f, #0c0c0c 70%);
}

.piece.ai {
  background: radial-gradient(circle at 30% 30%, #ffffff, #d5d5d5 75%);
}

.piece.small {
  width: 24rpx;
  height: 24rpx;
  box-shadow: inset 0 3rpx 7rpx rgba(0, 0, 0, 0.3);
}

.legend {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
  gap: 48rpx;
  font-size: 26rpx;
  color: #555555;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.actions {
  margin-top: 32rpx;
  display: flex;
  gap: 24rpx;
}

.actions button {
  width: 200rpx;
}

.tips {
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #808080;
  text-align: center;
  line-height: 1.6;
}

.toast {
  position: fixed;
  left: 50%;
  bottom: 120rpx;
  transform: translateX(-50%);
  min-width: 480rpx;
  max-width: 620rpx;
  padding: 24rpx 32rpx;
  border-radius: 24rpx;
  box-shadow: 0 18rpx 32rpx rgba(0, 0, 0, 0.18);
  color: #ffffff;
  display: flex;
  align-items: center;
  gap: 20rpx;
  animation: toastPop 0.3s ease;
  z-index: 999;
}

.toast-icon {
  font-size: 48rpx;
}

.toast-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.toast-title {
  font-size: 32rpx;
  font-weight: 700;
}

.toast-message {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1.6;
}

.toast-action {
  background: rgba(255, 255, 255, 0.2);
  border: none;
  color: #ffffff;
  font-size: 26rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
}

.toast-action::after {
  content: '';
}

@keyframes toastPop {
  from {
    opacity: 0;
    transform: translate(-50%, 30rpx);
  }
  to {
    opacity: 1;
    transform: translate(-50%, 0);
  }
}