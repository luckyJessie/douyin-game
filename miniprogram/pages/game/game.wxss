.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.status-panel {
  width: 100%;
  margin-bottom: 24rpx;
  text-align: center;
}

.message {
  font-size: 32rpx;
  color: #333333;
  font-weight: 600;
}

.controls {
  width: 100%;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
  margin-bottom: 28rpx;
}

.mode-switch {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.btn-mode {
  flex: 1;
  border-radius: 28rpx;
  border: 1rpx solid #d8d8d8;
  background: #f9f9f9;
  color: #555555;
}

.btn-mode.active {
  background: linear-gradient(135deg, #ffb347, #ffcc33);
  color: #2d2d2d;
  border: none;
  font-weight: 600;
}

.difficulty-picker {
  display: flex;
  align-items: center;
  gap: 20rpx;
  justify-content: center;
  flex-wrap: wrap;
}

.picker-display {
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  background: #f2f2f2;
  font-size: 26rpx;
  min-width: 200rpx;
  text-align: center;
  color: #444444;
}

.online-panel {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  align-items: center;
}

.room-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 26rpx;
  color: #444444;
  text-align: center;
}

.room-actions {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.room-input {
  width: 220rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid #d0d0d0;
  border-radius: 20rpx;
  font-size: 24rpx;
  background: #ffffff;
}

.online-status {
  font-size: 24rpx;
  color: #666666;
  text-align: center;
}

.turn-indicator {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666666;
  display: flex;
  justify-content: space-between;
  padding: 0 32rpx;
}

.first-player {
  color: #9c6b30;
}

.board {
  width: 640rpx;
  height: 640rpx;
  background: linear-gradient(135deg, #f7d794, #f3b167);
  padding: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.12);
  box-sizing: border-box;
}

.board-row {
  display: flex;
}

.cell {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  margin: 0;
  border: 1rpx solid rgba(80, 50, 20, 0.4);
  border-radius: 4rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background: rgba(255, 255, 255, 0.18);
}

.cell::before,
.cell::after {
  content: "";
  position: absolute;
  background: rgba(80, 50, 20, 0.6);
}

.cell::before {
  width: 2rpx;
  height: 100%;
}

.cell::after {
  height: 2rpx;
  width: 100%;
}

.cell.disabled {
  pointer-events: none;
}

.last-move {
  box-shadow: 0 0 0 6rpx rgba(255, 205, 96, 0.6);
}

.hint {
  box-shadow: 0 0 0 6rpx rgba(96, 152, 255, 0.55);
}

.piece {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  box-shadow: inset 0 4rpx 10rpx rgba(0, 0, 0, 0.35);
}

.piece.player {
  background: radial-gradient(circle at 30% 30%, #4f4f4f, #0c0c0c 70%);
}

.piece.ai {
  background: radial-gradient(circle at 30% 30%, #ffffff, #d5d5d5 75%);
}

.piece.small {
  width: 24rpx;
  height: 24rpx;
  box-shadow: inset 0 3rpx 7rpx rgba(0, 0, 0, 0.3);
}

.legend {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
  gap: 48rpx;
  font-size: 26rpx;
  color: #555555;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.actions {
  margin-top: 32rpx;
  display: flex;
  gap: 24rpx;
}

.actions button {
  width: 200rpx;
}

.tips {
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #808080;
  text-align: center;
  line-height: 1.6;
}