.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.status-panel {
  width: 100%;
  margin-bottom: 24rpx;
  text-align: center;
}

.message {
  font-size: 32rpx;
  color: #333333;
  font-weight: 600;
}

.controls {
  width: 100%;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
  margin-bottom: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.control-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  flex-wrap: wrap;
}

.control-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  align-items: center;
}

.tag {
  background: rgba(112, 75, 28, 0.08);
  color: #704b1c;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 1;
}

.tag.mode {
  background: rgba(255, 179, 71, 0.18);
  color: #b46c13;
}

.btn-link {
  border: none;
  background: none;
  color: #3a7afe;
  font-size: 26rpx;
  padding: 0;
  line-height: 1.4;
}

.btn-link::after {
  content: '';
}

.control-actions {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.online-panel {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  align-items: center;
}

.room-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 26rpx;
  color: #444444;
  text-align: center;
}

.room-actions {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.room-input {
  width: 220rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid #d0d0d0;
  border-radius: 20rpx;
  font-size: 24rpx;
  background: #ffffff;
}

.online-status {
  font-size: 24rpx;
  color: #666666;
  text-align: center;
}

.turn-indicator {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666666;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 0;
}

.first-player {
  color: #9c6b30;
}


.board {
  width: 720rpx;
  height: 720rpx;
  background: linear-gradient(135deg, #f9ddb0, #e9b668);
  padding: 40rpx;
  border-radius: 24rpx;
  box-shadow: 0 22rpx 36rpx rgba(0, 0, 0, 0.18);
  box-sizing: border-box;
  border: 2rpx solid rgba(80, 50, 20, 0.38);
  display: flex;
  flex-direction: column;
  position: relative;
  gap: 0;
}

.board::before {
  content: '';
  position: absolute;
  inset: 40rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  pointer-events: none;
  z-index: 0;
}

.board::after {
  content: '';
  position: absolute;
  inset: 36rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  pointer-events: none;
  z-index: 3;
}

.grid-layer {
  position: absolute;
  top: 40rpx;
  bottom: 40rpx;
  left: 40rpx;
  right: 40rpx;
  pointer-events: none;
  z-index: 1;
}

.grid-line {
  position: absolute;
  background: rgba(53, 33, 14, 0.32);
}

.grid-line.horizontal {
  left: 0;
  right: 0;
  height: 2rpx;
  transform: translateY(-1rpx);
}

.grid-line.vertical {
  top: 0;
  bottom: 0;
  width: 2rpx;
  transform: translateX(-1rpx);
}

.stone-layer {
  position: absolute;
  top: 40rpx;
  bottom: 40rpx;
  left: 40rpx;
  right: 40rpx;
  z-index: 2;
  pointer-events: none;
}

.piece-wrapper {
  position: absolute;
  width: 54rpx;
  height: 54rpx;
  transform: translate(-50%, -50%);
  display: flex;
  justify-content: center;
  align-items: center;
}

.piece-wrapper.last-move::after {
  content: '';
  position: absolute;
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  box-shadow: 0 0 0 6rpx rgba(255, 205, 96, 0.65);
  pointer-events: none;
}

.star-layer {
  position: absolute;
  top: 40rpx;
  bottom: 40rpx;
  left: 40rpx;
  right: 40rpx;
  z-index: 2;
  pointer-events: none;
}

.star-dot {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  transform: translate(-50%, -50%);
  background: rgba(53, 33, 14, 0.9);
  border-radius: 50%;
  box-shadow: 0 0 0 3rpx rgba(255, 255, 255, 0.2);
}

.touch-layer {
  position: absolute;
  top: 40rpx;
  bottom: 40rpx;
  left: 40rpx;
  right: 40rpx;
  z-index: 4;
}

.touch-point {
  position: absolute;
  width: 76rpx;
  height: 76rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: transparent;
}

.touch-point::after {
  content: '';
  position: absolute;
  inset: 0;
}

.touch-point:not(.disabled):active {
  background: rgba(255, 205, 96, 0.25);
}

.touch-point.disabled {
  pointer-events: none;
}

.touch-point.hint::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 42rpx;
  height: 42rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  border: 2rpx dashed rgba(96, 152, 255, 0.85);
  box-shadow: 0 0 12rpx rgba(96, 152, 255, 0.65);
  animation: hintPulse 1.2s ease-in-out infinite;
}

@keyframes hintPulse {
  0% {
    opacity: 0.8;
    transform: translate(-50%, -50%) scale(0.9);
  }
  50% {
    opacity: 0.2;
    transform: translate(-50%, -50%) scale(1.15);
  }
  100% {
    opacity: 0.8;
    transform: translate(-50%, -50%) scale(0.9);
  }
}

.piece {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  box-shadow: inset 0 4rpx 10rpx rgba(0, 0, 0, 0.35);
}

.piece.player {
  background: radial-gradient(circle at 30% 30%, #4f4f4f, #0c0c0c 70%);
}

.piece.ai {
  background: radial-gradient(circle at 30% 30%, #ffffff, #d5d5d5 75%);
}

.piece.small {
  width: 24rpx;
  height: 24rpx;
  box-shadow: inset 0 3rpx 7rpx rgba(0, 0, 0, 0.3);
}

.legend {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
  gap: 48rpx;
  font-size: 26rpx;
  color: #555555;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.actions {
  margin-top: 32rpx;
  display: flex;
  gap: 24rpx;
}

.actions button {
  width: 200rpx;
}

.tips {
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #808080;
  text-align: center;
  line-height: 1.6;
}