.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.status-panel {
  width: 100%;
  margin-bottom: 24rpx;
  text-align: center;
}

.message {
  font-size: 32rpx;
  color: #333333;
  font-weight: 600;
}

.controls {
  width: 100%;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
  margin-bottom: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.control-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  flex-wrap: wrap;
}

.control-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  align-items: center;
}

.tag {
  background: rgba(112, 75, 28, 0.08);
  color: #704b1c;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 1;
}

.tag.mode {
  background: rgba(255, 179, 71, 0.18);
  color: #b46c13;
}

.btn-link {
  border: none;
  background: none;
  color: #3a7afe;
  font-size: 26rpx;
  padding: 0;
  line-height: 1.4;
}

.btn-link::after {
  content: '';
}

.control-actions {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.online-panel {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  align-items: center;
}

.room-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 26rpx;
  color: #444444;
  text-align: center;
}

.room-actions {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.room-input {
  width: 220rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid #d0d0d0;
  border-radius: 20rpx;
  font-size: 24rpx;
  background: #ffffff;
}

.online-status {
  font-size: 24rpx;
  color: #666666;
  text-align: center;
}

.turn-indicator {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666666;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 0;
}

.first-player {
  color: #9c6b30;
}


.board {
  width: 640rpx;
  height: 640rpx;
  background: linear-gradient(145deg, #f7d794, #ebb86b);
  padding: 32rpx;
  border-radius: 20rpx;
  box-shadow: 0 18rpx 32rpx rgba(0, 0, 0, 0.18);
  box-sizing: border-box;
  border: 2rpx solid rgba(80, 50, 20, 0.4);
  display: flex;
  flex-direction: column;
  position: relative;
  gap: 0;
}

.board::before {
  content: '';
  position: absolute;
  inset: 32rpx;
  background-image:
    repeating-linear-gradient(0deg, rgba(53, 33, 14, 0.22) 0 1px, transparent 1px calc(100% / 15)),
    repeating-linear-gradient(90deg, rgba(53, 33, 14, 0.22) 0 1px, transparent 1px calc(100% / 15));
  pointer-events: none;
  z-index: 0;
}

.board::after {
  content: '';
  position: absolute;
  inset: 28rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  pointer-events: none;
  z-index: 1;
}

.board-row {
  flex: 1;
  display: flex;
}

.cell {
  flex: 1;
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
  background: transparent;
}

.cell.star-point::after {
  content: '';
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  background: rgba(53, 33, 14, 0.85);
  border-radius: 50%;
  box-shadow: 0 0 0 2rpx rgba(255, 255, 255, 0.2);
  transform: translate(-50%, -50%);
  top: 50%;
  left: 50%;
}

.cell.disabled {
  pointer-events: none;
}

.last-move {
  box-shadow: 0 0 0 6rpx rgba(255, 205, 96, 0.6);
}

.hint {
  box-shadow: 0 0 0 6rpx rgba(96, 152, 255, 0.55);
}

.piece {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  box-shadow: inset 0 4rpx 10rpx rgba(0, 0, 0, 0.35);
}

.piece.player {
  background: radial-gradient(circle at 30% 30%, #4f4f4f, #0c0c0c 70%);
}

.piece.ai {
  background: radial-gradient(circle at 30% 30%, #ffffff, #d5d5d5 75%);
}

.piece.small {
  width: 24rpx;
  height: 24rpx;
  box-shadow: inset 0 3rpx 7rpx rgba(0, 0, 0, 0.3);
}

.legend {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
  gap: 48rpx;
  font-size: 26rpx;
  color: #555555;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.actions {
  margin-top: 32rpx;
  display: flex;
  gap: 24rpx;
}

.actions button {
  width: 200rpx;
}

.tips {
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #808080;
  text-align: center;
  line-height: 1.6;
}