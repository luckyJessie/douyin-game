.home {
  min-height: 100vh;
  padding: 48rpx 32rpx 64rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.hero {
  text-align: center;
}

.title {
  font-size: 52rpx;
  font-weight: 700;
  color: #2f2f2f;
}

.subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #7a7a7a;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #683f14;
  margin-bottom: 16rpx;
}

.mode-section {
  display: flex;
  flex-direction: column;
}

.mode-options {
  display: flex;
  gap: 24rpx;
  flex-wrap: wrap;
}

.mode-card {
  flex: 1;
  min-width: 280rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
  border: 2rpx solid transparent;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

.mode-card.active {
  border-color: #ffb347;
  box-shadow: 0 16rpx 28rpx rgba(255, 179, 71, 0.28);
  transform: translateY(-6rpx);
}

.mode-card:active {
  transform: scale(0.98);
}

.mode-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #4b2c0d;
}

.mode-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

.settings {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.setting-group {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32rpx;
}

.setting-label {
  font-size: 28rpx;
  color: #444444;
}

.picker-display {
  padding: 12rpx 32rpx;
  background: #f5f5f5;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #333333;
}

.radio-group {
  display: flex;
  gap: 32rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #444444;
}

.tips {
  font-size: 24rpx;
  color: #5f5f5f;
  line-height: 1.7;
  background: rgba(58, 122, 254, 0.08);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.start-btn {
  margin-top: auto;
  background: linear-gradient(135deg, #ffb347, #ff9234);
  color: #2d2d2d;
  border: none;
  font-size: 30rpx;
  height: 96rpx;
  border-radius: 999rpx;
  box-shadow: 0 16rpx 28rpx rgba(255, 146, 52, 0.35);
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.start-btn::after {
  content: '';
}

.start-btn[disabled] {
  background: #d8d8d8;
  box-shadow: none;
  color: #888888;
}
