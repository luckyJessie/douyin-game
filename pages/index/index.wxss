.status {
  margin-bottom: 24rpx;
  font-size: 32rpx;
  color: #333333;
}

.config-panel {
  width: 100%;
  margin-bottom: 24rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
}

.difficulty-picker {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.difficulty-label {
  font-size: 30rpx;
  color: #2f2f2f;
  font-weight: 600;
}

.difficulty-desc {
  font-size: 26rpx;
  color: #666666;
}

.iterative-tip {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #ff9800;
}

.board-canvas {
  width: 650rpx;
  height: 650rpx;
  background-color: #f2c97d;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.panel {
  width: 100%;
  margin-top: 32rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.06);
  padding: 24rpx;
  box-sizing: border-box;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.move-scroll {
  max-height: 220rpx;
  margin-top: 18rpx;
}

.move-item {
  font-size: 26rpx;
  color: #444444;
  padding: 12rpx 0;
  border-bottom: 1px dashed #eeeeee;
}

.move-item:last-child {
  border-bottom: none;
}

.history-list {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.history-item {
  padding: 18rpx;
  border-radius: 10rpx;
  background-color: #f8f8f8;
}

.history-title {
  font-size: 28rpx;
  color: #2f2f2f;
  font-weight: 500;
}

.history-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #777777;
}

.clear-btn {
  min-width: 120rpx;
}

.info-panel {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #555555;
  display: flex;
  gap: 48rpx;
}

.controls {
  margin-top: 32rpx;
}
