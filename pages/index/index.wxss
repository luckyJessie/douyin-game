.container {
  padding: 24rpx;
  box-sizing: border-box;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.hero {
  padding: 48rpx;
  border-radius: 32rpx;
  color: #ffffff;
  box-shadow: 0 12rpx 40rpx rgba(92, 157, 255, 0.25);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.brand {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.brand-badge {
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: 8rpx;
}

.brand-title {
  font-size: 44rpx;
  font-weight: 700;
}

.brand-slogan {
  font-size: 28rpx;
  opacity: 0.85;
}

.status-card,
.tips-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.status-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
}

.status-label {
  color: #6c6c6c;
}

.status-player {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-weight: 600;
  color: #ffffff;
  background: #333333;
}

.status-player.white {
  background: #ffffff;
  color: #333333;
  border: 2rpx solid #eeeeee;
}

.status-text {
  font-weight: 600;
  color: #333333;
}

.status-actions {
  display: flex;
  gap: 16rpx;
}

.btn-primary,
.btn-secondary {
  flex: 1;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #5c9dff 0%, #8de1d1 100%);
  color: #ffffff;
  border: none;
}

.btn-secondary {
  background: #f0f3f8;
  color: #3d5a80;
  border: none;
}

.btn-secondary[disabled] {
  color: #a3afc4;
}

.board-wrapper {
  background: #f2d7a6;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: inset 0 0 0 1rpx rgba(120, 78, 27, 0.12), 0 20rpx 40rpx rgba(120, 78, 27, 0.18);
}

.board {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.board-row {
  display: flex;
}

.cell {
  width: 42rpx;
  height: 42rpx;
  border: 1rpx solid rgba(120, 78, 27, 0.25);
  box-sizing: border-box;
  position: relative;
  background-color: rgba(242, 199, 139, 0.6);
}

.cell::after {
  content: "";
  position: absolute;
  top: -1rpx;
  right: -1rpx;
  bottom: -1rpx;
  left: -1rpx;
  pointer-events: none;
}

.cell-highlight {
  background-color: rgba(92, 157, 255, 0.25);
}

.piece {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  box-shadow: inset 0 4rpx 8rpx rgba(255, 255, 255, 0.7), inset 0 -6rpx 10rpx rgba(0, 0, 0, 0.25), 0 6rpx 12rpx rgba(0, 0, 0, 0.2);
}

.piece.black {
  background: radial-gradient(circle at 30% 30%, #6f7b8a, #1a1f24);
}

.piece.white {
  background: radial-gradient(circle at 30% 30%, #ffffff, #cfd5dd);
  box-shadow: inset 0 2rpx 4rpx rgba(255, 255, 255, 0.65), inset 0 -4rpx 8rpx rgba(0, 0, 0, 0.18), 0 4rpx 8rpx rgba(0, 0, 0, 0.15);
}

.tips-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c3e50;
}

.tips-item {
  font-size: 26rpx;
  color: #5c7080;
  line-height: 1.6;
}

@media (max-width: 400px) {
  .cell {
    width: 38rpx;
    height: 38rpx;
  }

  .piece {
    width: 28rpx;
    height: 28rpx;
  }
}
