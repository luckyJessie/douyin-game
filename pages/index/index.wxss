.container {
  padding: 20rpx;
  background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.game-info {
  text-align: center;
  margin-bottom: 20rpx;
  color: #fff;
}

.status-text {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.player-info {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.player-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 15rpx 25rpx;
  border-radius: 15rpx;
  background: rgba(255, 255, 255, 0.1);
  transition: all 0.3s;
  opacity: 0.7;
}

.player-item.active {
  background: rgba(255, 255, 255, 0.25);
  opacity: 1;
  transform: scale(1.05);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.player-label {
  font-size: 24rpx;
  font-weight: 500;
}

.chess-piece-preview {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.chess-piece-preview.black {
  background: radial-gradient(circle at 30% 30%, #666, #000);
}

.chess-piece-preview.white {
  background: radial-gradient(circle at 30% 30%, #fff, #ddd);
}

.vs-text {
  font-size: 24rpx;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.8);
}

/* 棋盘区域 */
.chessboard-wrapper {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 20rpx 0;
}

.chessboard-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  padding: 20rpx;
  border-radius: 25rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.3);
}

.chessboard-content {
  display: flex;
  align-items: center;
}

/* 坐标显示 */
.coordinate-row {
  display: flex;
  justify-content: center;
  padding: 5rpx 0;
}

.coordinate-col {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 5rpx;
}

.coordinate {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #666;
  font-weight: 500;
}

/* 棋盘 */
.chessboard {
  position: relative;
  background: linear-gradient(135deg, #d4a574 0%, #c89f6d 100%);
  border: 4rpx solid #8b6f47;
  box-shadow: inset 0 0 30rpx rgba(0, 0, 0, 0.1);
}

/* 网格线 */
.board-grid {
  position: absolute;
  width: 100%;
  height: 100%;
  pointer-events: none;
  top: 0;
  left: 0;
}

.grid-line {
  position: absolute;
  background: #8b6f47;
}

.grid-line.vertical {
  width: 1.5rpx;
  height: 100%;
  transform: translateX(-50%);
}

.grid-line.horizontal {
  height: 1.5rpx;
  width: 100%;
  transform: translateY(-50%);
}

/* 星位 */
.star-point {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #8b6f47;
  z-index: 5;
  box-shadow: 0 0 2rpx rgba(0, 0, 0, 0.3);
  transform: translate(-50%, -50%);
}

.star-point.center {
  width: 16rpx;
  height: 16rpx;
  background: #6b5130;
}

/* 棋盘行 */
.chess-row {
  display: flex;
  flex: 1;
}

/* 棋盘单元格 */
.chess-cell {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  aspect-ratio: 1;
  cursor: pointer;
}

.chess-cell:active {
  background: rgba(139, 111, 71, 0.1);
}

/* 棋子 */
.chess-piece {
  width: 75%;
  height: 75%;
  border-radius: 50%;
  position: relative;
  z-index: 10;
  box-shadow: 
    0 4rpx 8rpx rgba(0, 0, 0, 0.4),
    inset 0 -2rpx 4rpx rgba(0, 0, 0, 0.2);
  animation: placePiece 0.2s ease-out;
}

@keyframes placePiece {
  from {
    transform: scale(0);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

.chess-piece.black {
  background: radial-gradient(circle at 35% 35%, #4a4a4a, #1a1a1a);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.chess-piece.white {
  background: radial-gradient(circle at 35% 35%, #ffffff, #e0e0e0);
  border: 2rpx solid rgba(0, 0, 0, 0.1);
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  justify-content: center;
  gap: 15rpx;
  margin-top: 30rpx;
  flex-wrap: wrap;
}

.btn {
  flex: 1;
  min-width: 200rpx;
  border: none;
  border-radius: 50rpx;
  padding: 24rpx 30rpx;
  font-size: 28rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  transition: all 0.2s;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.9);
  color: #667eea;
}

.btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
}
