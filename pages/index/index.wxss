.container {
  padding: 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
}

.game-info {
  text-align: center;
  margin-bottom: 30rpx;
  color: #fff;
}

.status-text {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.player-info {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 30rpx;
}

.player-label {
  font-size: 28rpx;
}

.active {
  opacity: 1;
  transform: scale(1.2);
}

.chessboard-container {
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 20rpx 0;
  background: rgba(255, 255, 255, 0.1);
  padding: 20rpx;
  border-radius: 20rpx;
}

.chessboard {
  position: relative;
  background: #deb887;
  border: 3rpx solid #8b4513;
  display: flex;
  flex-direction: column;
}

.chess-row {
  display: flex;
  flex: 1;
}

.chess-cell {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  border-right: 2rpx solid #8b4513;
  border-bottom: 2rpx solid #8b4513;
}

.chess-row .chess-cell:last-child {
  border-right: none;
}

.chessboard .chess-row:last-child .chess-cell {
  border-bottom: none;
}

.cell-line {
  position: absolute;
  width: 100%;
  height: 100%;
  background-image: 
    linear-gradient(to right, #8b4513 1px, transparent 1px),
    linear-gradient(to bottom, #8b4513 1px, transparent 1px);
  background-size: 100% 15px, 15px 100%;
}

.chess-piece {
  width: 70%;
  height: 70%;
  border-radius: 50%;
  position: relative;
  z-index: 10;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.3);
}

.chess-piece.black {
  background: radial-gradient(circle at 30% 30%, #666, #000);
}

.chess-piece.white {
  background: radial-gradient(circle at 30% 30%, #fff, #ddd);
}

.action-buttons {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-top: 30rpx;
}

.btn {
  background: rgba(255, 255, 255, 0.9);
  color: #667eea;
  border: none;
  border-radius: 10rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.btn:active {
  background: rgba(255, 255, 255, 0.7);
}
