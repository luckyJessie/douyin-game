/* pages/index/index.wxss */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.header {
  width: 100%;
  text-align: center;
  margin-bottom: 30rpx;
  padding: 20rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
  display: block;
  margin-bottom: 20rpx;
}

.status {
  margin-top: 20rpx;
}

.status-text {
  font-size: 32rpx;
  color: #fff;
  background-color: rgba(255, 255, 255, 0.2);
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  display: inline-block;
}

.game-board {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.board {
  background-color: #DEB887;
  border: 4rpx solid #8B4513;
  border-radius: 10rpx;
  padding: 10rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.3);
}

.row {
  display: flex;
}

.cell {
  width: 40rpx;
  height: 40rpx;
  border: 1rpx solid #8B4513;
  background-color: #DEB887;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.cell::after {
  content: '';
  position: absolute;
  width: 100%;
  height: 100%;
  border: 1rpx solid rgba(139, 69, 19, 0.3);
}

.piece {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  z-index: 10;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.cell.black .piece {
  background: radial-gradient(circle at 30% 30%, #666, #000);
}

.cell.white .piece {
  background: radial-gradient(circle at 30% 30%, #fff, #ddd);
  border: 1rpx solid #ccc;
}

.controls {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.btn {
  background-color: #fff;
  color: #667eea;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.2);
  transition: all 0.3s;
}

.btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

button[disabled] {
  opacity: 0.5;
  color: #999;
}

.info {
  width: 100%;
  max-width: 600rpx;
}

.player-info {
  display: flex;
  justify-content: space-around;
  background-color: rgba(255, 255, 255, 0.9);
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.1);
}

.player {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.player-piece {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.player-piece.black {
  background: radial-gradient(circle at 30% 30%, #666, #000);
}

.player-piece.white {
  background: radial-gradient(circle at 30% 30%, #fff, #ddd);
  border: 1rpx solid #ccc;
}

.player text {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}
