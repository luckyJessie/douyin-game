<view class="container">
  <view class="status">{{message}}</view>
  <view class="config-panel">
    <picker mode="selector" range="{{difficultyLevels}}" range-key="label" value="{{difficultyIndex}}" bindchange="onDifficultyChange">
      <view class="difficulty-picker">
        <view class="difficulty-label">难度：{{difficultyLevels[difficultyIndex].label}}</view>
        <view class="difficulty-desc">{{difficultyLevels[difficultyIndex].desc}}</view>
      </view>
    </picker>
    <view class="iterative-tip" wx:if="{{useIterativeDeepening}}">迭代加深已启用，AI 思考更深入</view>
  </view>
  <canvas
    canvas-id="boardCanvas"
    bindtap="handleTap"
    disable-scroll="true"
    class="board-canvas">
  </canvas>
  <view class="info-panel">
    <view>执黑：玩家</view>
    <view>执白：AI</view>
  </view>
  <view class="controls">
    <button type="primary" size="default" bindtap="resetGame">重新开始</button>
  </view>
  <view class="panel" wx:if="{{moveList.length}}">
    <view class="panel-title">当前棋谱</view>
    <scroll-view scroll-y="true" class="move-scroll">
      <block wx:for="{{moveList}}" wx:key="index">
        <view class="move-item">{{index + 1}}. {{item.playerLabel}} {{item.coord}}</view>
      </block>
    </scroll-view>
  </view>
  <view class="panel" wx:if="{{historyRecords.length}}">
    <view class="panel-header">
      <view class="panel-title">历史对局</view>
      <button size="mini" bindtap="clearHistory" class="clear-btn">清空</button>
    </view>
    <view class="history-list">
      <block wx:for="{{historyRecords}}" wx:key="id">
        <view class="history-item">
          <view class="history-title">{{item.title}}</view>
          <view class="history-meta">{{item.createdAtText}}</view>
        </view>
      </block>
    </view>
  </view>
</view>
