<view class="container">
  <canvas
    type="2d"
    canvas-id="board"
    class="board"
    style="width:{{canvasSize}}px;height:{{canvasSize}}px;"
    bindtouchend="handleTouch"
  ></canvas>

  <view class="panel">
    <text class="message">{{message}}</text>

    <view class="controls">
      <view class="control-row">
        <view class="control-item">
          <text class="control-label">对战模式</text>
          <picker mode="selector" range="{{modeOptions}}" range-key="label" value="{{modeIndex}}" bindchange="handleModeChange">
            <view class="picker-value">{{modeOptions[modeIndex].label}}</view>
          </picker>
        </view>
        <view class="control-item" wx:if="{{mode === 'HUMAN_VS_AI'}}">
          <text class="control-label">AI 难度</text>
          <picker mode="selector" range="{{difficultyOptions}}" range-key="label" value="{{difficultyIndex}}" bindchange="handleDifficultyChange">
            <view class="picker-value">{{difficultyOptions[difficultyIndex].label}}</view>
          </picker>
        </view>
      </view>

      <view class="control-row" wx:if="{{mode === 'HUMAN_VS_AI'}}">
        <button size="mini" bindtap="toggleFirst">{{humanFirst ? '切换电脑先手' : '切换玩家先手'}}</button>
        <button size="mini" type="primary" bindtap="restartGame">重新开始</button>
      </view>
      <view class="control-row" wx:if="{{mode !== 'HUMAN_VS_AI'}}">
        <button size="mini" type="primary" bindtap="restartGame">重新开始</button>
      </view>

      <view class="control-row">
        <button size="mini" bindtap="undoMove">悔棋</button>
        <button size="mini" bindtap="redoMove">撤销悔棋</button>
        <button size="mini" bindtap="openHistoryPanel">历史复盘</button>
      </view>
    </view>

    <view class="online-panel" wx:if="{{mode === 'ONLINE'}}">
      <input
        class="room-input"
        placeholder="输入房间号，如 A1001"
        confirm-type="done"
        value="{{onlineRoomId}}"
        bindinput="handleRoomInput"
      />
      <view class="control-row">
        <button size="mini" type="primary" bindtap="connectOnline">{{onlineStatus === 'connected' ? '重新连接' : '加入房间'}}</button>
        <button size="mini" wx:if="{{onlineStatus === 'connected'}}" bindtap="leaveOnlineRoom">离开房间</button>
      </view>
      <text class="tip">{{onlineStatusText}}</text>
    </view>

    <text class="tip">提示：点击棋盘交叉点即可落子；悔棋会在人人对弈模式撤销一步，在人机模式撤销双方最近的落子。</text>
  </view>

  <view wx:if="{{historyVisible}}" class="history-overlay">
    <view class="history-dialog">
      <view class="history-header">
        <text>历史复盘</text>
        <button size="mini" bindtap="closeHistoryPanel">关闭</button>
      </view>
      <scroll-view scroll-y class="history-list">
        <view
          class="history-item"
          wx:for="{{historyList}}"
          wx:key="moveNumber"
          data-index="{{index}}"
        >
          <view class="history-info">
            <text class="history-label">{{item.label}}</text>
            <text class="history-sub">{{item.detail}}</text>
          </view>
          <view class="history-actions">
            <button size="mini" bindtap="previewHistory" data-index="{{index}}">预览</button>
            <button size="mini" type="primary" bindtap="applyHistory" data-index="{{index}}">回到此步</button>
          </view>
        </view>
      </scroll-view>
      <button size="mini" bindtap="resumeCurrentGame">恢复当前棋局</button>
    </view>
  </view>
</view>
