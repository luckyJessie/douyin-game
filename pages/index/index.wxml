<view class="container">
  <view class="game-info">
    <view class="status-text">{{gameStatus}}</view>
    <view class="player-info">
      <text class="player-label">玩家：</text>
      <text class="{{currentPlayer === 1 ? 'active' : ''}}">⚫</text>
      <text class="player-label">电脑：</text>
      <text class="{{currentPlayer === 2 ? 'active' : ''}}">⚪</text>
    </view>
  </view>
  
  <view class="chessboard-container">
    <view class="chessboard" style="width: {{boardSize}}px; height: {{boardSize}}px;">
      <view 
        wx:for="{{board}}" 
        wx:for-item="row" 
        wx:for-index="i"
        wx:key="i"
        class="chess-row"
      >
        <view 
          wx:for="{{row}}" 
          wx:for-item="cell" 
          wx:for-index="j"
          wx:key="j"
          class="chess-cell"
          data-row="{{i}}"
          data-col="{{j}}"
          bindtap="onCellTap"
        >
          <view class="cell-line"></view>
          <view wx:if="{{cell === 1}}" class="chess-piece black"></view>
          <view wx:elif="{{cell === 2}}" class="chess-piece white"></view>
        </view>
      </view>
    </view>
  </view>
  
  <view class="action-buttons">
    <button class="btn" bindtap="restartGame">重新开始</button>
    <button class="btn" bindtap="undoMove">悔棋</button>
  </view>
</view>
