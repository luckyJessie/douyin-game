<view class="container">
  <view class="game-info">
    <view class="status-text">{{gameStatus}}</view>
    <view class="player-info">
      <view class="player-item {{currentPlayer === 1 ? 'active' : ''}}">
        <text class="player-label">玩家</text>
        <view class="chess-piece-preview black"></view>
      </view>
      <text class="vs-text">VS</text>
      <view class="player-item {{currentPlayer === 2 ? 'active' : ''}}">
        <view class="chess-piece-preview white"></view>
        <text class="player-label">{{gameMode === 'ai' ? '电脑' : '玩家2'}}</text>
      </view>
    </view>
    <!-- 倒计时显示 -->
    <view class="timer-container" wx:if="{{!gameOver && currentPlayer === 1}}">
      <view class="timer-text">剩余时间：{{timeLeft}}秒</view>
      <view class="timer-bar">
        <view class="timer-progress" style="width: {{timeProgress}}%"></view>
      </view>
    </view>
  </view>
  
  <view class="chessboard-wrapper">
    <view class="chessboard-container">
      <!-- 棋盘 -->
      <view class="chessboard" style="width: {{boardSize}}px; height: {{boardSize}}px;">
        <!-- 背景网格线 -->
        <view class="board-grid">
          <view wx:for="{{15}}" wx:key="*this" wx:for-index="idx" class="grid-line vertical" style="left: {{(boardSize / 15) * idx}}px;"></view>
          <view wx:for="{{15}}" wx:key="*this" wx:for-index="idx" class="grid-line horizontal" style="top: {{(boardSize / 15) * idx}}px;"></view>
        </view>
        
        <!-- 星位标记（天元+四个星位） -->
        <view class="star-point" style="left: {{boardSize / 15 * 3}}px; top: {{boardSize / 15 * 3}}px;"></view>
        <view class="star-point" style="left: {{boardSize / 15 * 11}}px; top: {{boardSize / 15 * 3}}px;"></view>
        <view class="star-point" style="left: {{boardSize / 15 * 3}}px; top: {{boardSize / 15 * 11}}px;"></view>
        <view class="star-point" style="left: {{boardSize / 15 * 11}}px; top: {{boardSize / 15 * 11}}px;"></view>
        <view class="star-point center" style="left: {{boardSize / 15 * 7}}px; top: {{boardSize / 15 * 7}}px;"></view>
        
        <!-- 棋子 -->
        <view 
          wx:for="{{board}}" 
          wx:for-item="row" 
          wx:for-index="i"
          wx:key="i"
          class="chess-row"
        >
          <view 
            wx:for="{{row}}" 
            wx:for-item="cell" 
            wx:for-index="j"
            wx:key="j"
            class="chess-cell"
            data-row="{{i}}"
            data-col="{{j}}"
            bindtap="onCellTap"
          >
            <view wx:if="{{cell === 1}}" class="chess-piece black"></view>
            <view wx:elif="{{cell === 2}}" class="chess-piece white"></view>
          </view>
        </view>
      </view>
    </view>
  </view>
  
  <view class="action-buttons">
    <button class="btn btn-secondary" bindtap="goBack">返回菜单</button>
    <button class="btn btn-primary" bindtap="restartGame">重新开始</button>
    <button class="btn btn-secondary" bindtap="undoMove">悔棋</button>
  </view>
</view>
