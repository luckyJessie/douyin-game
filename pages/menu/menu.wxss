.menu-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 60rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
}

.header {
  text-align: center;
  margin-bottom: 80rpx;
}

.title {
  display: block;
  font-size: 72rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  margin-bottom: 20rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  letter-spacing: 8rpx;
}

.menu-content {
  flex: 1;
}

.menu-section {
  margin-bottom: 60rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 30rpx;
  padding-left: 10rpx;
}

.options {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.option-item {
  flex: 1;
  min-width: 200rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15rpx;
  border: 3rpx solid transparent;
  transition: all 0.3s;
}

.option-item.active {
  background: rgba(255, 255, 255, 0.3);
  border-color: #fff;
  transform: scale(1.05);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.2);
}

.option-icon {
  font-size: 48rpx;
}

.option-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

.footer {
  margin-top: 40rpx;
  padding-bottom: 40rpx;
}

.start-btn {
  width: 100%;
  background: linear-gradient(135deg, #fff 0%, #f0f0f0 100%);
  color: #667eea;
  border: none;
  border-radius: 50rpx;
  padding: 30rpx;
  font-size: 36rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.3);
}

.start-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.2);
}
